add_column|MaxSimultaneousEnemiesAttacking2|byte                  // for when BNpcBase->Unk49_3 is true, overrides MaxSimultaneousEnemiesAttacking. ref: 40 8A 78 ? 48 8B CE E8 ? ? ? ? 8B CD, ref2: 45 8A 66
add_column|OutgoingDamagePercent|byte                             // ref: 0F B6 48 ? BF
add_column|UnusedUnk28|byte                                       // No references?
add_column|OutgoingWillDamagePercent|byte                         // ref: 0F B6 48 ? B8 ? ? ? ? 45 8A 85
add_column|HpRegainPotentialPercentAfterDamage|byte               // Nourishment Bit bypasses this - ref: 0F B6 78 ? 48 85 D2, ref2: 44 0F B6 60 ? 48 85 D2
add_column|Unk31|byte                                             // Could be level related - ref: 0F B6 4B ? 8B D0
add_column|CanPartyMembersDealDamage|byte                         // Maybri: Torgal's Sic and Ravage can still do damage. - ref (func - CanPartyMemberDealDamageFromCurrentDifficulty): 40 38 68 ? 75 ? 41 84 AE. that function seems important and some other columns may affect the result? i.e attackparam->Unk64_3 and bnpcbase->UnkType2
add_column|UseEnemyParamRate|byte                                 // previously 'IsIncreaseEnemyLevel' - use ParamGrow and BNpcParamRate basically - refer to all use of 48 89 5C 24 ? 57 48 83 EC ? E8 ? ? ? ? 8B F8 33 DB 48 8B 05 ? ? ? ? 48 85 C0 75 ? 48 8B 0D ? ? ? ? 48 85 C9 74 ? BA ? ? ? ? E8 ? ? ? ? 48 89 05 ? ? ? ? 48 85 C0 74 ? 8B D7 48 8B C8 E8 ? ? ? ? 48 85 C0 74 ? 48 39 18 7C ? 48 8B C8 E8 ? ? ? ? 48 8B D8 EB ? 48 8D 1D ? ? ? ? 8A 43
