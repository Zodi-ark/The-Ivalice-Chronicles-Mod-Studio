add_column|MaxSimultaneousEnemiesAttacking|byte                   // (Maybri): Enemy Aggression (number of enemies that simultaneously attack Clive) - ref: 44 8A 60 ? 48 8B CF, ref2: 40 8A 78 ? 48 8B CE E8 ? ? ? ? 80 B8
add_column|ActionTransitionLengthIndex|byte                       // Action table, index into FollowupTransitionLength. Last array element is selected if this is above the number of parameters for the current action. ref: 48 89 5C 24 ? 48 89 74 24 ? 57 48 83 EC ? 48 8B F9 33 DB 48 8B 89 ? ? ? ? 48 85 C9
add_column|UnusedUnk21|byte                                       // No references?
add_column|UnusedUnk22|byte                                       // No references?
add_column|UseDoonMashingType|byte                                // ref: 44 38 70 ? 74 ? 48 85 DB 75 ? 49 8B C6, ref2: 8A 58 ? 48 8B 87 - uses doonmashingtype+0x55
add_column|CliveLevelCap|byte                                     // ParamGrow id. 5 added to this if rising tide dlc is unlocked, OR 10 added to this if echoes dlc is unlocked - ref: 48 89 5C 24 ? 57 48 83 EC ? E8 ? ? ? ? 8B F8 33 DB 48 8B 05 ? ? ? ? 48 85 C0 75 ? 48 8B 0D ? ? ? ? 48 85 C9 74 ? BA ? ? ? ? E8 ? ? ? ? 48 89 05 ? ? ? ? 48 85 C0 74 ? 8B D7 48 8B C8 E8 ? ? ? ? 48 85 C0 74 ? 48 39 18 7C ? 48 8B C8 E8 ? ? ? ? 48 8B D8 EB ? 48 8D 1D ? ? ? ? 0F B6 5B
