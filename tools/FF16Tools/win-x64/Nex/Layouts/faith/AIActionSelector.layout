table_name|AIActionSelector
set_table_type|DoubleKeyed
set_table_category|DoubleKeyed
use_base_row_id|false

define_struct|Unk28_struct
add_struct_column|UnkShort1|short
add_struct_column|UnkShort2|short
end_struct|

///////////////////////////////////////////////////////

add_column|DLCFlags|int
add_column|Unk2|int
add_column|ActionId|int
add_column|MaxDistForExecute|float
add_column|MinDistForExecute|float
add_column|Unk6|float
add_column|Unk7|float
add_column|Unk8|int
add_column|Unk9|float
add_column|Priority|int

// Related to the following, should only be array length 1 or 2
// checked against hardcoded numbers? ffxvi.exe steam 1.0.1 - sub_1404D1898 check a3
// maybe this is another one of those id type to id
add_column|Unk11|int[]

// Not always?
add_column|LayoutNamedInstanceId1Maybe|int
add_column|LayoutNamedInstanceId2Maybe|int
add_column|Unk15|int
add_column|Unk16|int
add_column|Unk17|float[]
add_column|Cooldown|float

// ref: 0F BE 40 ? 89 44 24
add_column|Unk20_1|byte
add_column|Unk20_2|byte
add_column|Unk20_3|byte
add_column|Unk20_4|byte

add_column|Unk21|int
add_column|Unk22|int
add_column|Comment|string

// some hardcoded checks
add_column|Unk24|int    // ref: 83 78 ? ? 74 ? 48 85 C9 75 ? 33 C0 EB ? 48 83 39 ? 7C ? E8 ? ? ? ? EB ? 48 8D 05
add_column|Unk25|float  // ref: C5 FA 10 70 ? C5 F8 28 CE

// The following columns control "ports". If row1 has an input port that's equal to the output port of row2, row1 will be executed right after row2, regardless of priority.
// This will happen, for instance, if row1 has an input port of 30 and row2 has an output port of 30.
// Multiple actions can be chained together using ports.
add_column|InputPort|int   // ref: 83 78 ? ? 7F ? 81 63
add_column|OutputPort|int  // ref: 8B 40 ? 89 44 24 ? 48 85 DB

add_column|Unk28|Unk28_struct[]   // NOTE: This one is put at the end of the file anyhow - fine to ignore
add_column|Unk30|int  // ref (both): 41 8B 48 ? 41 8B 45
add_column|Unk31|int  // ref (both): 41 8B 48 ? 41 8B 45
add_column|Unk32|int  // ref: 44 8B 41 ? 45 8B CE 41 8B 84 24 ? ? ? ? 41 8B D7 48 8B 7C 24
