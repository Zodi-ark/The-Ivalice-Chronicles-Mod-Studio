<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mod Studio's checks of the helper, run by dev/test_event_setup.py and
       dev/test_side_quests.py: the helper's own finding, changing and
       planning code over a program's file laid out as it lies in memory, and
       over tables as the game loads them; (1.2.5) its markers' painting,
       (1.3.0) the mods' own places' pieces and (1.4.0) their roads' pictures
       over a stand-in for the world map screen (MarkerChecks.cs,
       PlaceChecks.cs, RoadChecks.cs); (1.7.0) the mods' places the game goes
       to (DestinationChecks.cs), (1.7.1) with their homes and a save's
       fallback (SaveFallback.cs); (1.13.0) the numbers' three copies and a
       save's mark (NumberChecks.cs); (1.23.0) a mod's dungeon's list's looks over a
       stand-in for the Deep's list (LooksChecks.cs); (1.26.0) a mod's own items over his program
       (ItemChecks.cs), and (1.28.0) the game's weapons' looks (ItemLooks.cs); (1.29.0) the numbers given as
       each game starts and freed, and the settings' file (NumberChecks.cs); (1.36.0) a mod's own job over his
       program (JobChecks.cs). Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseAppHost>false</UseAppHost>
